{
  "extends": "@mlc/config/tsconfig",
  "compilerOptions": {
    "module": "es2023",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "noEmit": false,
    "composite": true
  },
  "include": ["src/**/*"]
}
