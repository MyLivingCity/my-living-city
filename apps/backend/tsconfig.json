{
  "extends": "@mlc/config/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["vitest/globals"],
    "paths": {
      "@mlc/lib": ["../../packages/lib/src/index.ts"],
      "@mlc/lib/*": ["../../packages/lib/src/*"],
      "#prisma/client": ["node_modules/.prisma/client/client"]
    }
  },
  "references": [
    { "path": "../../packages/lib" }
  ],
  "include": ["src/**/*", "src/server"]
}
